# Dropbox
DROPBOX_ACCESS_TOKEN=
# Preferred for unattended use:
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

DROPBOX_APPROVED_FOLDER=/Etsy/Approved
DROPBOX_UPSCALED_FOLDER=/Etsy/Upscaled
DROPBOX_NEEDS_REVIEW_FOLDER=/Etsy/Needs-Review

# Replicate
REPLICATE_API_TOKEN=
# Current smoke-test model. Official Replicate Real-ESRGAN supports scale + face_enhance.
REPLICATE_MODEL=nightmareai/real-esrgan
# Optional: pin an exact version ID. Leave blank to use the model endpoint/current version.
REPLICATE_MODEL_VERSION=

# Automatic fallback for GPU out-of-memory failures.
# xinntao/realesrgan supports tiled processing specifically for OOM cases.
REPLICATE_FALLBACK_ON_OOM=true
REPLICATE_FALLBACK_MODEL=xinntao/realesrgan
REPLICATE_FALLBACK_TILE=400
REPLICATE_FALLBACK_VERSION_NAME=General - v3

# Upscale behavior
# 1536 x 1536 at 3x => 4608 x 4608
UPSCALE_FACTOR=3
FACE_ENHANCE=false
MIN_OUTPUT_WIDTH=4500
MIN_OUTPUT_HEIGHT=4500
DIMENSION_TOLERANCE_PX=8

# Operational behavior
REQUEST_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=2
MAX_POLL_SECONDS=900
COPY_FAILURES_TO_REVIEW=true
OVERWRITE_OUTPUT=false
LOG_LEVEL=INFO

# Etsy
# Keep mock mode until Etsy credentials are configured.
ETSY_MODE=mock
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=
ETSY_OUTBOX_DIR=.etsy_mock_outbox

# Etsy listing image generation
GENERATE_LISTING_IMAGES=true
DROPBOX_LISTING_IMAGES_FOLDER=/Etsy/Listing-Images
ETSY_LISTING_IMAGE_WIDTH=2400
ETSY_LISTING_IMAGE_HEIGHT=2000
ETSY_LISTING_IMAGE_JPEG_QUALITY=90
