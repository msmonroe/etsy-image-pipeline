# Dropbox
DROPBOX_ACCESS_TOKEN=
# Preferred for unattended use:
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

DROPBOX_APPROVED_FOLDER=/Etsy/Approved
DROPBOX_UPSCALED_FOLDER=/Etsy/Upscaled
DROPBOX_NEEDS_REVIEW_FOLDER=/Etsy/Needs-Review

# Replicate
REPLICATE_API_TOKEN=
# Exact Replicate model VERSION id, not a webpage URL.
REPLICATE_MODEL_VERSION=

# Upscale behavior
UPSCALE_FACTOR=3
FACE_ENHANCE=false
MIN_OUTPUT_WIDTH=4000
MIN_OUTPUT_HEIGHT=4000

# Operational behavior
REQUEST_TIMEOUT_SECONDS=300
POLL_INTERVAL_SECONDS=2
MAX_POLL_SECONDS=900
COPY_FAILURES_TO_REVIEW=true
OVERWRITE_OUTPUT=false
LOG_LEVEL=INFO
